@{
    Layout = "_Layout";
    ViewData["Title"] = "♞ - Chessboard";
}

<h1><span>♞</span> Think Ahead</h1>

<p>It's a <strong>chess</strong> game.</p>
<p>Except you only have <strong>5 moves</strong> available.</p>
<p>You get to see the what your opponent could play from after your turn.</p>
<p><strong>Think Ahead. Choose wisely!</strong></p>

@using(Html.BeginForm("Create", "Game", FormMethod.Post))
{
    <button type="submit" class="submit">Start Game</button>
}
